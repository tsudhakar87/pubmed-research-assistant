# .env
PROJECT_ID=project_id_here
REGION=us-central1
ENVIRONMENT=Development

# database
DATABASE_URL=postgresql://user:pass@host:5432/bioinfo_db
BIGQUERY_DATASET=bioinfo_analytics

# vertex ai
VERTEX_AI_LOCATION=us-central1
MODEL_NAME=text-bison@001

# mcp servers
MCP_DATABASE_SERVER_URL=https://database-server-xxx.run.app
MCP_VECTOR_SERVER_URL=https://vector-server-xxx.run.app
MCP_ANALYTICS_SERVER_URL=https://analytics-server-xxx.run.app

# external apis
NCBI_EMAIL=your-email@example.com  # Required by NCBI E-utilities
NCBI_API_KEY=your_ncbi_api_key_here  # Optional, increases rate limit to 10 req/s